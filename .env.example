# --- Claude ---
# Default: reuse your local Claude Code login (run `claude` once and log in with Pro/Max).
# Use a DIFFERENT account than your terminal: log in once with
#   CLAUDE_CONFIG_DIR=~/.claude-autoclip claude
# then point the app at that directory:
# CLAUDE_CONFIG_DIR=/Users/you/.claude-autoclip
# Headless server: run `claude setup-token` and paste the token here.
# CLAUDE_CODE_OAUTH_TOKEN=
# Or bill the API instead:
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=sonnet

# --- MoneyPrinterTurbo (video render engine) ---
MPT_URL=http://127.0.0.1:8080
MPT_API_KEY=

# --- Postiz (publishing to TikTok / YouTube / Facebook / Instagram ...) ---
# Self-hosted: http://localhost:4007/api   Cloud: https://api.postiz.com
POSTIZ_URL=http://localhost:4007/api
# Postiz → Settings → Public API → copy key
POSTIZ_API_KEY=
